{
  "name": "LifeOS",
  "short_name": "LifeOS",
  "description": "Organizador pessoal offline: agenda, estudos, finanças, treinos, alimentação e metas.",
  "lang": "pt-BR",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f4f3f8",
  "theme_color": "#7c5cff",
  "categories": ["productivity", "finance", "education", "health"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Assistente", "url": "./#/assistant", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Agenda", "url": "./#/agenda", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Finanças", "url": "./#/finance", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
